#!/usr/bin/env python3

import argparse
import json
import time
import urllib.request
import urllib.error


def check_service(url, timeout=5):
    start = time.perf_counter()

    try:
        request = urllib.request.Request(
            url,
            headers={"User-Agent": "Veltrix-HealthCheck/1.0"}
        )

        with urllib.request.urlopen(request, timeout=timeout) as response:
            elapsed = round((time.perf_counter() - start) * 1000, 2)

            return {
                "url": url,
                "status": response.status,
                "response_ms": elapsed,
                "healthy": 200 <= response.status < 400
            }

    except urllib.error.HTTPError as error:
        elapsed = round((time.perf_counter() - start) * 1000, 2)

        return {
            "url": url,
            "status": error.code,
            "response_ms": elapsed,
            "healthy": False
        }

    except Exception as error:
        elapsed = round((time.perf_counter() - start) * 1000, 2)

        return {
            "url": url,
            "status": None,
            "response_ms": elapsed,
            "healthy": False,
            "error": str(error)
        }


def main():
    parser = argparse.ArgumentParser(
        description="Minimal API health checker."
    )

    parser.add_argument(
        "urls",
        nargs="+",
        help="URLs to check"
    )

    parser.add_argument(
        "--timeout",
        type=int,
        default=5,
        help="Request timeout in seconds"
    )

    parser.add_argument(
        "--json",
        action="store_true",
        help="Return results as JSON"
    )

    args = parser.parse_args()

    results = [
        check_service(url, args.timeout)
        for url in args.urls
    ]

    if args.json:
        print(json.dumps(results, indent=2))
        return

    for result in results:
        state = "OK" if result["healthy"] else "FAIL"

        print(
            f"[{state}] "
            f"{result['url']} | "
            f"status={result['status']} | "
            f"{result['response_ms']}ms"
        )


if __name__ == "__main__":
    main()
